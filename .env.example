# Copy to .env and fill in. Never commit .env.

# Model for `python -m rag_lab answer` and `python -m rag_lab eval`.
RAG_LAB_LLM_MODEL=qwen3:8b

# Local OpenAI-compatible server. Leave blank to use hosted OpenAI.
# Ollama on this machine:      http://localhost:11434/v1
# Ollama on the container host: http://host.docker.internal:11434/v1
RAG_LAB_LLM_BASE_URL=http://localhost:11434/v1

# Required only when RAG_LAB_LLM_BASE_URL is blank. Local runtimes ignore it.
# The key is never hard-coded in source.
OPENAI_API_KEY=
